// ================= LOGO KHỞI ĐỘNG "TUIOT" (đúng 3 giây) =================
// Dòng thời gian (tính theo millis, nên luôn xong ~3000ms dù SPI nhanh hay chậm):
//    0 -  400 ms : màn hình bật kiểu CRT (đường sáng ngang -> mở ra toàn màn hình)
//  400 - 1500 ms : 5 chữ T-U-I-O-T rơi từ trên xuống, nảy khi chạm đất, sáng trắng rồi lên màu
// 1500 - 2100 ms : 4 góc khung hiện ra, gạch chân sáng mở rộng từ giữa, dòng phụ gõ từng chữ
// 2100 - 2800 ms : ánh sáng quét qua từng chữ (shine)
// 2800 - 3000 ms : màn hình tắt kiểu CRT (khép từ trên và dưới vào giữa)
constexpr uint16_t rgb565(uint8_t r, uint8_t g, uint8_t b) {
  return (uint16_t)(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3));
}

constexpr int SP_N    = 5;                       // số chữ trong "TUIOT"
constexpr int SP_SC   = 4;                       // phóng to x4 -> mỗi chữ 32x64
constexpr int SP_GW   = 8 * SP_SC;
constexpr int SP_GH   = 16 * SP_SC;
constexpr int SP_GAP  = 10;                      // khoảng cách giữa các chữ
constexpr int LINE_W  = SP_N * SP_GW + (SP_N - 1) * SP_GAP;   // 200
constexpr int SP_X0   = (SCR_W - LINE_W) / 2;
constexpr int SP_Y    = 30;                      // vị trí cuối của hàng chữ
constexpr int SP_LINE_Y = 98;                    // gạch chân
constexpr int SP_SUB_Y  = 110;                   // dòng phụ

constexpr uint32_t SP_TB = 400, SP_TC = 1500, SP_TD = 2100, SP_TE = 2800, SP_TOTAL = 3000;

constexpr uint16_t SP_BG    = rgb565(5, 10, 32);            // xanh navy đậm
constexpr uint16_t SP_LINE  = rgb565(190, 240, 255);
constexpr uint16_t SP_SUB   = rgb565(150, 175, 210);
constexpr uint16_t SP_FLASH = rgb565(255, 255, 255);
constexpr uint16_t SP_COL[SP_N] = {                         // dải màu cyan -> tím
  rgb565(0, 229, 255), rgb565(40, 180, 255), rgb565(90, 130, 255),
  rgb565(150, 90, 255), rgb565(210, 70, 230)
};

const char SP_TXT[]    = "TUIOT";
const char SP_SUBTXT[] = "DS28E07 / DS2430A";

float bounceOut(float t) {                       // hiệu ứng nảy khi chạm đất
  if (t < 1.0f / 2.75f) return 7.5625f * t * t;
  if (t < 2.0f / 2.75f) { t -= 1.5f / 2.75f;   return 7.5625f * t * t + 0.75f; }
  if (t < 2.5f / 2.75f) { t -= 2.25f / 2.75f;  return 7.5625f * t * t + 0.9375f; }
  t -= 2.625f / 2.75f;
  return 7.5625f * t * t + 0.984375f;
}

// Vẽ ký tự "đặc" (có cả màu nền) và cắt theo mép trên/dưới màn hình -> di chuyển không bị nháy
void splashGlyph(int x, int y, const uint8_t *g, uint16_t fg, uint16_t bg) {
  for (int r = 0; r < 16; r++) {
    int py = y + r * SP_SC;
    if (py < 0 || py + SP_SC > SCR_H) continue;
    uint8_t b = g[r];
    int c = 0;
    while (c < 8) {
      bool on = (b & (0x80 >> c)) != 0;
      int st = c;
      while (c < 8 && ((b & (0x80 >> c)) != 0) == on) c++;
      fillR(x + st * SP_SC, py, (c - st) * SP_SC, SP_SC, on ? fg : bg);
    }
  }
}

// Xoá dải ngang [y0, y1) bề rộng 1 chữ (phần ký tự cũ không còn bị ký tự mới che)
void splashErase(int x, int y0, int y1) {
  if (y0 < 0) y0 = 0;
  if (y1 > SCR_H) y1 = SCR_H;
  if (y1 > y0) fillR(x, y0, SP_GW, y1 - y0, SP_BG);
}

void splashLetter(int i, int y, uint16_t col) {
  splashGlyph(SP_X0 + i * (SP_GW + SP_GAP), y, vnGlyph(SP_TXT[i]), col, SP_BG);
}

void splashCorners(uint16_t c) {                 // 4 góc khung
  const int m = 4, L = 14, T = 2;
  fillR(m, m, L, T, c);                          fillR(m, m, T, L, c);
  fillR(SCR_W - m - L, m, L, T, c);              fillR(SCR_W - m - T, m, T, L, c);
  fillR(m, SCR_H - m - T, L, T, c);              fillR(m, SCR_H - m - L, T, L, c);
  fillR(SCR_W - m - L, SCR_H - m - T, L, T, c);  fillR(SCR_W - m - T, SCR_H - m - L, T, L, c);
}

void showSplash() {
  const uint32_t t0 = millis();
  uint32_t t;

  // ---------- A. Bật màn hình kiểu CRT ----------
  fillR(0, 0, SCR_W, SCR_H, 0x0000);
  const int cy = SCR_H / 2;
  int lw = 0;
  while ((t = millis() - t0) < 150) {            // đường sáng ngang mở rộng từ giữa
    int w = (int)(SCR_W * t / 150);
    if (w > lw) { fillR((SCR_W - w) / 2, cy - 1, w, 2, SP_LINE); lw = w; }
  }
  fillR(0, cy - 1, SCR_W, 2, SP_LINE);

  int pTop = cy - 1, pH = 2;                     // vùng đã mở (viền trên/dưới là đường sáng)
  while ((t = millis() - t0) < SP_TB) {          // mở theo chiều dọc
    int h = 2 + (int)((SCR_H - 2) * (t - 150) / (SP_TB - 150));
    h &= ~1;
    if (h > pH && h <= SCR_H) {
      int top = (SCR_H - h) / 2;
      fillR(0, pTop, SCR_W, 1, SP_BG);                       // xoá viền cũ
      fillR(0, pTop + pH - 1, SCR_W, 1, SP_BG);
      fillR(0, top, SCR_W, pTop - top, SP_BG);               // dải mới phía trên
      fillR(0, pTop + pH, SCR_W, (top + h) - (pTop + pH), SP_BG);   // dải mới phía dưới
      fillR(0, top, SCR_W, 1, SP_LINE);                      // viền sáng mới
      fillR(0, top + h - 1, SCR_W, 1, SP_LINE);
      pTop = top; pH = h;
    }
  }
  fillR(0, 0, SCR_W, SCR_H, SP_BG);

  // ---------- B. Các chữ rơi xuống và nảy ----------
  int  cyL[SP_N];
  bool settled[SP_N];
  for (int i = 0; i < SP_N; i++) { cyL[i] = -SP_GH; settled[i] = false; }
  const uint32_t STAG = 150, DUR = 500;
  const uint32_t endB = SP_TB + (SP_N - 1) * STAG + DUR;     // = SP_TC
  while (true) {
    t = millis() - t0;
    for (int i = 0; i < SP_N; i++) {
      uint32_t st = SP_TB + i * STAG;
      if (t < st) continue;
      float p = (float)(t - st) / (float)DUR;
      if (p > 1.0f) p = 1.0f;
      bool fin = (p >= 1.0f);
      int ny = fin ? SP_Y : (-SP_GH) + (int)((SP_Y + SP_GH) * bounceOut(p));
      if (ny == cyL[i] && (!fin || settled[i])) continue;
      int x = SP_X0 + i * (SP_GW + SP_GAP);
      if (ny > cyL[i]) splashErase(x, cyL[i], (ny < cyL[i] + SP_GH) ? ny : cyL[i] + SP_GH);
      else             splashErase(x, (ny + SP_GH > cyL[i]) ? ny + SP_GH : cyL[i], cyL[i] + SP_GH);
      splashLetter(i, ny, fin ? SP_COL[i] : SP_FLASH);       // đang rơi = trắng, chạm đất = lên màu
      cyL[i] = ny;
      if (fin) settled[i] = true;
    }
    if (t >= endB) break;
  }

  // ---------- C. Khung góc + gạch chân + dòng phụ gõ từng chữ ----------
  splashCorners(SP_COL[0]);
  const int subLen = (int)(sizeof(SP_SUBTXT) - 1);
  const int subX = (SCR_W - subLen * 8) / 2;
  int lineW = 0, shown = 0;
  while ((t = millis() - t0) < SP_TD) {
    float p = (float)(t - SP_TC) / 350.0f;
    if (p > 1.0f) p = 1.0f;
    p = 1.0f - (1.0f - p) * (1.0f - p);                      // ease-out
    int w = (int)(LINE_W * p);
    if (w > lineW) { fillR(SP_X0 + (LINE_W - w) / 2, SP_LINE_Y, w, 3, SP_LINE); lineW = w; }
    int n = (t > SP_TC + 200) ? (int)((t - SP_TC - 200) / 30) : 0;
    if (n > subLen) n = subLen;
    while (shown < n) {
      char s[2] = { SP_SUBTXT[shown], 0 };
      txt(subX + shown * 8, SP_SUB_Y, s, SP_SUB);
      shown++;
    }
  }
  if (lineW < LINE_W) fillR(SP_X0, SP_LINE_Y, LINE_W, 3, SP_LINE);
  txt(subX, SP_SUB_Y, SP_SUBTXT, SP_SUB);                    // đảm bảo đủ cả dòng

  // ---------- D. Ánh sáng quét qua các chữ, E. Tắt kiểu CRT ----------
  int shineLast = -2;
  int closed = 0;
  while ((t = millis() - t0) < SP_TOTAL) {
    if (t < SP_TE) {
      int pos = (int)(((t - SP_TD) / 70) % 7);               // 0..4 = chữ đang sáng, 5..6 = nghỉ
      int hl = (pos < SP_N) ? pos : -1;
      if (hl != shineLast) {
        if (shineLast >= 0) splashLetter(shineLast, SP_Y, SP_COL[shineLast]);
        if (hl >= 0)        splashLetter(hl, SP_Y, SP_FLASH);
        shineLast = hl;
      }
    } else {
      float p = (float)(t - SP_TE) / (float)(SP_TOTAL - SP_TE);
      int c = (int)((SCR_H / 2) * p);                        // khép từ trên và dưới vào giữa
      if (c > closed) {
        fillR(0, closed, SCR_W, c - closed, 0x0000);
        fillR(0, SCR_H - c, SCR_W, c - closed, 0x0000);
        closed = c;
      }
    }
  }
}

// ================= ARDUINO =================
void setup() {
  Serial.begin(115200);

  pinMode(PIN_NAV, INPUT_PULLUP);
  pinMode(PIN_SEL, INPUT_PULLUP);

  loadSettings();
  loadBackup();
  loadDevices();
  if (digitalRead(PIN_SEL) == LOW) {          // giữ SEL lúc cấp nguồn = reset cài đặt màn hình
    g_orient = 1; g_flipX = false; g_flipY = true; g_inv = false;
    saveSettings();
    Serial.println("Đã khôi phục cài đặt màn hình mặc định");
  }

  SPI.begin(PIN_TFT_SCK, -1, PIN_TFT_SDI, PIN_TFT_CS);
  tft.begin();
  applyDisplay();
  showSplash();                               // logo TUIOT 3 giây

  Serial.println("\nDS28E07 + DS2430A menu tool - ESP32-S3 / ILI9225");
  Serial.printf("Số thiết bị mã mới: %d\n", g_nDev);
  if (g_hasBk) {
    Serial.print("MÃ CŨ đã lưu (ROM "); printHexLine(g_bkRom, 8);
    Serial.print("): "); printHexLine(g_bkData, WRITE_LEN); Serial.println();
  }
  drawMenu();
}

void loop() {
  Event e = pollButtons();
  if (e == EV_NEXT) {
    int old = menuSel;
    menuSel = (menuSel + 1) % MENU_N;
    drawMenuItem(old);
    drawMenuItem(menuSel);
  } else if (e == EV_SELECT) {
    switch (menuSel) {
      case 0: doRead(); break;
      case 1: {                                   // GHI MÃ MỚI: chọn thiết bị rồi ghi đúng mã
        int d = pickDevice("CHỌN MÃ MỚI");
        if (d >= 0) {
          char lb[24];
          snprintf(lb, sizeof(lb), "MÃ MỚI %d", d + 1);
          runWrite(g_dev[d], "GHI MÃ MỚI", lb, false, false);
        }
        break;
      }
      case 2: {                                   // GHI MÃ MỚI RANDOM: byte cuối random
        int d = pickDevice("CHỌN MÃ MỚI");
        if (d >= 0) {
          char lb[24];
          snprintf(lb, sizeof(lb), "MÃ MỚI %d RANDOM", d + 1);
          runWrite(g_dev[d], "GHI MÃ MỚI RANDOM", lb, true, false);
        }
        break;
      }
      case 3: runWrite(nullptr, "KHÔI PHỤC MÃ CŨ", "MÃ CŨ", false, true); break;   // ghi lại mã đã đọc/lưu
      case 4: runDevices(); break;
      case 5: runSettings(); break;
    }
    drawMenu();
  }
  delay(5);
}