// ================= CÀI ĐẶT MÀN HÌNH (NVS) =================
void loadSettings() {
  prefs.begin("tftcfg", false);
  g_orient = prefs.getUChar("o", 1);
  g_flipX  = prefs.getBool("fx", false);
  g_flipY  = prefs.getBool("fy", true);
  g_inv    = prefs.getBool("inv", false);
  if (g_orient != 1 && g_orient != 3) g_orient = 1;
}

void saveSettings() {
  prefs.putUChar("o", g_orient);
  prefs.putBool("fx", g_flipX);
  prefs.putBool("fy", g_flipY);
  prefs.putBool("inv", g_inv);
}

void applyDisplay() {
  tft.setOrientation(g_orient);
  tft.invert(g_inv);
}

// ================= NÚT NHẤN =================
bool     navDown = false, selDown = false;
uint32_t navEdge = 0, selEdge = 0;

Event pollButtons() {
  uint32_t now = millis();

  bool n = digitalRead(PIN_NAV) == LOW;
  if (n && !navDown && now - navEdge > 30) {
    navDown = true; navEdge = now;
  } else if (!n && navDown && now - navEdge > 30) {
    navDown = false; navEdge = now;
    return EV_NEXT;
  }

  bool s = digitalRead(PIN_SEL) == LOW;
  if (s && !selDown && now - selEdge > 30) {
    selDown = true; selEdge = now;
  } else if (!s && selDown && now - selEdge > 30) {
    selDown = false; selEdge = now;
    return EV_SELECT;
  }
  return EV_NONE;
}

void waitAnyButton() {
  while (true) {
    if (pollButtons() != EV_NONE) return;
    delay(5);
  }
}

// ================= TIỆN ÍCH IN =================
void printHexLine(const uint8_t *b, size_t len) {
  for (size_t i = 0; i < len; i++) Serial.printf("%02X ", b[i]);
}

const char *describeProtect(uint8_t v) {
  if (v == 0x55) return "KHÓA GHI";
  if (v == 0xAA) return "EPROM mode";
  return "mở";
}

// ================= BACKUP MÃ CŨ (NVS) =================
// MÃ CŨ = 16 byte đọc được từ chip, lưu cùng ROM ID để chỉ khôi phục đúng chip đó.
bool    g_hasBk = false;
uint8_t g_bkRom[8];
uint8_t g_bkData[WRITE_LEN];

void loadBackup() {
  g_hasBk = (prefs.getBytesLength("bkdat") == WRITE_LEN && prefs.getBytesLength("bkrom") == 8);
  if (g_hasBk) {
    prefs.getBytes("bkrom", g_bkRom, 8);
    prefs.getBytes("bkdat", g_bkData, WRITE_LEN);
  }
}

// ================= DANH SÁCH THIẾT BỊ MÃ MỚI (NVS) =================
constexpr int MAX_DEV = 8;
uint8_t g_dev[MAX_DEV][WRITE_LEN];
int     g_nDev = 0;

void saveDevices() {
  prefs.putUChar("ndev", (uint8_t)g_nDev);
  if (g_nDev > 0) prefs.putBytes("devs", g_dev, g_nDev * WRITE_LEN);
  else            prefs.remove("devs");
}

void loadDevices() {
  uint8_t n = prefs.getUChar("ndev", 255);
  if (n == 255) {                              // lần chạy đầu: nạp NEW_DATA làm thiết bị số 1
    memcpy(g_dev[0], NEW_DATA, WRITE_LEN);
    g_nDev = 1;
    saveDevices();
    return;
  }
  if (n > MAX_DEV) n = 0;
  if (n > 0 && prefs.getBytesLength("devs") == (size_t)n * WRITE_LEN) {
    prefs.getBytes("devs", g_dev, n * WRITE_LEN);
    g_nDev = n;
  } else {
    g_nDev = 0;
  }
}

// MÃ MỚI: 15 byte đầu khớp BẤT KỲ thiết bị nào trong danh sách (bỏ qua byte cuối - random)
int findNewIdx(const uint8_t *d) {
  for (int i = 0; i < g_nDev; i++)
    if (memcmp(d, g_dev[i], WRITE_LEN - 1) == 0) return i;
  return -1;
}

bool isNewCode(const uint8_t *d) {
  return findNewIdx(d) >= 0;
}

// Lưu 16 byte vừa đọc làm "mã cũ". Không lưu nếu chip đang là MÃ MỚI (tránh mất mã gốc).
bool saveBackup(const uint8_t *rom, const uint8_t *data) {
  if (isNewCode(data)) return false;
  memcpy(g_bkRom, rom, 8);
  memcpy(g_bkData, data, WRITE_LEN);
  prefs.putBytes("bkrom", g_bkRom, 8);
  prefs.putBytes("bkdat", g_bkData, WRITE_LEN);
  g_hasBk = true;
  Serial.print("Đã lưu MÃ CŨ: "); printHexLine(g_bkData, WRITE_LEN); Serial.println();
  return true;
}

const char *nameOf(const uint8_t *d) {
  static char nb[16];
  int i = findNewIdx(d);
  if (i >= 0) { snprintf(nb, sizeof(nb), "MÃ MỚI %d", i + 1); return nb; }
  if (g_hasBk && memcmp(d, g_bkData, WRITE_LEN) == 0) return "MÃ CŨ";
  return "KHÁC";
}

bool fail(const char *msg) {
  g_err = msg;
  Serial.println(msg);
  return false;
}

// ================= TFT: hình chữ nhật có lật X/Y bằng phần mềm =================
// Toạ độ (x,y) là toạ độ logic, gốc trên-trái. Nếu màn hình bị lật thì bật g_flipX / g_flipY.
void fillR(int x, int y, int w, int h, uint16_t col) {
  int px = g_flipX ? SCR_W - x - w : x;
  int py = g_flipY ? SCR_H - y - h : y;
  tft.fillRectangle(px, py, px + w - 1, py + h - 1, col);
}

void strokeR(int x, int y, int w, int h, uint16_t col) {
  int px = g_flipX ? SCR_W - x - w : x;
  int py = g_flipY ? SCR_H - y - h : y;
  tft.drawRectangle(px, py, px + w - 1, py + h - 1, col);
}

// ================= TFT: chữ tiếng Việt (UTF-8) bằng font bitmap 8x16 =================
const uint8_t *vnGlyph(uint16_t cp) {
  int lo = 0, hi = VN_N - 1;
  while (lo <= hi) {
    int mid = (lo + hi) / 2;
    uint16_t v = VN_CP[mid];
    if (v == cp) return VN_GLYPH[mid];
    if (v < cp) lo = mid + 1; else hi = mid - 1;
  }
  return nullptr;
}

// Đọc 1 ký tự UTF-8 (tối đa 3 byte), tăng con trỏ
uint16_t nextCp(const char *&s) {
  uint8_t c = (uint8_t)*s++;
  if (c < 0x80) return c;
  if ((c & 0xE0) == 0xC0 && s[0]) {
    uint16_t cp = (uint16_t)((c & 0x1F) << 6) | (uint16_t)(s[0] & 0x3F);
    s += 1;
    return cp;
  }
  if ((c & 0xF0) == 0xE0 && s[0] && s[1]) {
    uint16_t cp = (uint16_t)((c & 0x0F) << 12) | (uint16_t)((s[0] & 0x3F) << 6) | (uint16_t)(s[1] & 0x3F);
    s += 2;
    return cp;
  }
  return '?';
}

int txtLen(const char *s) {            // số ký tự (không phải số byte)
  int n = 0;
  while (*s) { nextCp(s); n++; }
  return n;
}

void drawGlyph(int x, int y, const uint8_t *g, uint16_t col, int sc) {
  if (x < 0 || y < 0 || x + 8 * sc > SCR_W || y + 16 * sc > SCR_H) return;   // chống tràn màn hình
  for (int r = 0; r < 16; r++) {
    uint8_t b = g[r];
    if (!b) continue;
    int c = 0;
    while (c < 8) {
      if (b & (0x80 >> c)) {
        int st = c;
        while (c < 8 && (b & (0x80 >> c))) c++;
        fillR(x + st * sc, y + r * sc, (c - st) * sc, sc, col);
      } else {
        c++;
      }
    }
  }
}

// Vẽ chuỗi UTF-8, (x,y) là góc trên-trái, mỗi ký tự rộng 8*sc, cao 16*sc. Nền trong suốt.
void txtS(int x, int y, const char *s, uint16_t col, int sc) {
  while (*s) {
    uint16_t cp = nextCp(s);
    if (cp != ' ') {
      const uint8_t *g = vnGlyph(cp);
      if (!g) g = vnGlyph('?');
      if (g) drawGlyph(x, y, g, col, sc);
    }
    x += 8 * sc;
  }
}

void txt(int x, int y, const char *s, uint16_t col) {
  txtS(x, y, s, col, 1);
}

// ================= TFT: khung màn hình =================
void drawScreen(const char *title, const char *hint) {
  fillR(0, 0, SCR_W, SCR_H, C_BG);
  fillR(0, 0, SCR_W, HDR_H, C_HEAD);
  txt(6, 3, title, C_WHITE);
  fillR(0, SCR_H - FOOT_H, SCR_W, FOOT_H, C_BAR);
  txt(4, SCR_H - FOOT_H + 1, hint, C_DIM);
}

void clearBody() {
  fillR(0, HDR_H, SCR_W, SCR_H - HDR_H - FOOT_H, C_BG);
}

// 16 byte thành 2 dòng, mỗi dòng 8 byte chia 2 nhóm: "00C366CC 519A4EDE"
void drawHex16(int x, int y, const uint8_t *d, uint16_t col) {
  char b[24];
  for (int r = 0; r < 2; r++) {
    const uint8_t *p = d + r * 8;
    snprintf(b, sizeof(b), "%02X%02X%02X%02X %02X%02X%02X%02X",
             p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
    txt(x, y + r * 16, b, col);
  }
}

void drawRom(int y, const uint8_t *rom) {
  char b[40];
  snprintf(b, sizeof(b), "ROM %02X %02X %02X %02X %02X %02X %02X %02X",
           rom[0], rom[1], rom[2], rom[3], rom[4], rom[5], rom[6], rom[7]);
  txt(2, y, b, C_WARN);
}

void showResult(bool ok, const char *l1, const char *l2) {
  clearBody();
  int sc = (txtLen(l1) * 16 <= SCR_W - 12) ? 2 : 1;      // chữ to nếu đủ chỗ
  txtS(6, 34, l1, ok ? C_OK : C_ERR, sc);
  txt(6, 34 + sc * 16 + 8, l2, C_TEXT);
  txt(6, SCR_H - FOOT_H - 20, "Bấm SEL để quay lại", C_DIM);
}

// ================= 1-WIRE CƠ BẢN =================
ChipType chipTypeOf(const uint8_t *rom) {
  if (rom[0] == FAMILY_28E07) return CT_28E07;
  if (rom[0] == FAMILY_2430A) return CT_2430A;
  return CT_NONE;
}

const char *chipName(ChipType t) {
  if (t == CT_28E07) return "DS28E07";
  if (t == CT_2430A) return "DS2430A";
  return "?";
}

// Số byte cần đọc/kiểm tra của từng loại chip
uint16_t dumpLen(ChipType t) {
  return (t == CT_2430A) ? PAGE_2430A : DUMP_LEN;
}

// Read Memory (F0h): DS28E07 gửi TA1 + TA2 (2 byte địa chỉ), DS2430A chỉ gửi 1 byte địa chỉ
bool readMemory(ChipType t, const uint8_t *rom, uint16_t addr, uint8_t *buf, size_t len) {
  if (!ds.reset()) return false;
  ds.select(rom);
  ds.write(CMD_READ_MEMORY);
  ds.write(addr & 0xFF);                    // TA1
  if (t == CT_28E07) ds.write(addr >> 8);   // TA2 (chỉ DS28E07)
  for (size_t i = 0; i < len; i++) buf[i] = ds.read();
  ds.reset();
  return true;
}

bool findChip(uint8_t *rom) {
  for (uint8_t t = 1; t <= MAX_TRIES; t++) {
    ds.reset_search();
    if (ds.search(rom)) {
      ds.reset_search();
      if (OneWire::crc8(rom, 7) == rom[7]) return true;
      Serial.printf("  lần thử %u: ROM ID sai CRC\n", t);
    } else {
      ds.reset_search();
      Serial.printf("  lần thử %u: không thấy chip\n", t);
    }
    delay(30);
  }
  g_err = "Kiểm tra dây và trở kéo";
  Serial.println("[LỖI] Không đọc được ROM ID. Kiểm tra tiếp xúc, điện trở kéo lên 1k-2.2k.");
  return false;
}

// Tìm chip và nhận diện loại. Nếu lỗi / chip lạ thì tự hiện màn hình báo lỗi, chờ bấm nút rồi trả về false.
bool findSupported(uint8_t *rom, ChipType &ct) {
  if (!findChip(rom)) { showResult(false, "KHÔNG CÓ CHIP", g_err); waitAnyButton(); return false; }
  ct = chipTypeOf(rom);
  if (ct == CT_NONE) {
    Serial.printf("[LỖI] Family code 0x%02X không hỗ trợ (chỉ 0x2D = DS28E07, 0x14 = DS2430A).\n", rom[0]);
    showResult(false, "CHIP LẠ", "Chỉ hỗ trợ 2D và 14");
    waitAnyButton();
    return false;
  }
  return true;
}

// Đọc hai lượt (dumpLen byte), phải trùng nhau
bool readStable(ChipType t, const uint8_t *rom, uint8_t *out) {
  static uint8_t b[DUMP_LEN];
  const uint16_t n = dumpLen(t);
  for (uint8_t k = 1; k <= MAX_TRIES; k++) {
    if (!readMemory(t, rom, 0x0000, out, n) || !readMemory(t, rom, 0x0000, b, n)) {
      delay(50);
      continue;
    }
    if (memcmp(out, b, n) == 0) return true;
    delay(50);
  }
  g_err = "Dữ liệu không ổn định";
  Serial.println("[LỖI] Dữ liệu không ổn định. Kiểm tra tiếp xúc.");
  return false;
}

// DS28E07: ghi 1 hàng 8 byte qua scratchpad: Write SP -> Read SP (kiểm tra) -> Copy SP
bool writeRow(const uint8_t *rom, uint16_t addr, const uint8_t *data) {
  if (addr & 7)        return fail("Địa chỉ không chia hết 8");
  if (addr + 8 > 0x80) return fail("Ngoài vùng user memory");
  const uint8_t ta1 = addr & 0xFF, ta2 = addr >> 8;
  uint8_t crc[2];

  uint8_t ws[3 + 8] = { CMD_WRITE_SP, ta1, ta2 };
  memcpy(ws + 3, data, 8);
  if (!ds.reset()) return fail("Mất presence (Write SP)");
  ds.select(rom);
  for (uint8_t i = 0; i < sizeof(ws); i++) ds.write(ws[i]);
  crc[0] = ds.read();
  crc[1] = ds.read();
  if (!OneWire::check_crc16(ws, sizeof(ws), crc)) return fail("CRC16 sai (Write SP)");

  uint8_t rs[1 + 3 + 8];
  rs[0] = CMD_READ_SP;
  if (!ds.reset()) return fail("Mất presence (Read SP)");
  ds.select(rom);
  ds.write(CMD_READ_SP);
  for (uint8_t i = 1; i < sizeof(rs); i++) rs[i] = ds.read();
  crc[0] = ds.read();
  crc[1] = ds.read();
  if (!OneWire::check_crc16(rs, sizeof(rs), crc)) return fail("CRC16 sai (Read SP)");
  const uint8_t es = rs[3];
  if (rs[1] != ta1 || rs[2] != ta2) return fail("Địa chỉ scratchpad lệch");
  if ((es & 0xA7) != 0x07)          return fail("E/S bất thường");
  if (memcmp(rs + 4, data, 8) != 0) return fail("Scratchpad khác dữ liệu");

  if (!ds.reset()) return fail("Mất presence (Copy SP)");
  ds.select(rom);
  ds.write(CMD_COPY_SP);
  ds.write(ta1);
  ds.write(ta2);
  ds.write(es, 1);            // giữ strong pullup khi lập trình
  delay(T_PROG_MS);
  ds.depower();
  uint8_t st = ds.read();
  ds.reset();
  if (st == 0xFF) return fail("Chip không xác nhận copy");
  return true;
}

// DS2430A: ghi cả 32 byte: Write SP (0F) -> Read SP (AA, kiểm tra) -> Copy SP (55 + khóa A5).
// DS2430A không có CRC16 và không trả lời sau lệnh copy, nên việc kiểm tra cuối cùng là đọc lại EEPROM.
bool writePage2430A(const uint8_t *rom, const uint8_t *img) {
  static uint8_t sp[PAGE_2430A];

  if (!ds.reset()) return fail("Mất presence (Write SP)");
  ds.select(rom);
  ds.write(CMD_WRITE_SP);
  ds.write(0x00);                           // địa chỉ bắt đầu
  for (uint16_t i = 0; i < PAGE_2430A; i++) ds.write(img[i]);

  if (!ds.reset()) return fail("Mất presence (Read SP)");
  ds.select(rom);
  ds.write(CMD_READ_SP);
  ds.write(0x00);
  for (uint16_t i = 0; i < PAGE_2430A; i++) sp[i] = ds.read();
  if (memcmp(sp, img, PAGE_2430A) != 0) {
    ds.reset();
    return fail("Scratchpad khác dữ liệu");   // EEPROM chưa bị đổi
  }

  if (!ds.reset()) return fail("Mất presence (Copy SP)");
  ds.select(rom);
  ds.write(CMD_COPY_SP);
  ds.write(KEY_COPY_2430A, 1);              // validation key, rồi giữ strong pullup khi lập trình
  delay(T_PROG_MS);
  ds.depower();
  ds.reset();
  return true;
}

// Ghi 16 byte newData vào 0x00..0x0F của chip đã nhận diện. cur = nội dung chip vừa đọc (readStable).
bool writeUser16(ChipType t, const uint8_t *rom, const uint8_t *cur, const uint8_t *newData) {
  if (t == CT_28E07) {
    for (uint16_t off = 0; off < WRITE_LEN; off += 8)
      if (!writeRow(rom, WRITE_ADDR + off, newData + off)) return false;
    return true;
  }
  uint8_t img[PAGE_2430A];                  // DS2430A: giữ nguyên 0x10..0x1F, chỉ thay 0x00..0x0F
  memcpy(img, cur, PAGE_2430A);
  memcpy(img + WRITE_ADDR, newData, WRITE_LEN);
  return writePage2430A(rom, img);
}

// ================= CHỨC NĂNG 1: ĐỌC =================
void doRead() {
  drawScreen("ĐỌC THIẾT BỊ", "SEL: quay lại menu");
  txt(6, 60, "Đang đọc chip...", C_TEXT);

  uint8_t rom[8];
  if (!findChip(rom)) { showResult(false, "KHÔNG CÓ CHIP", g_err); waitAnyButton(); return; }
  ChipType ct = chipTypeOf(rom);
  if (ct == CT_NONE) {
    Serial.print("ROM ID : "); printHexLine(rom, 8); Serial.println();
    Serial.printf("[LỖI] Family code 0x%02X không hỗ trợ (chỉ 0x2D = DS28E07, 0x14 = DS2430A).\n", rom[0]);
    clearBody();
    drawRom(24, rom);
    txt(2, 48, "Chip không hỗ trợ", C_ERR);
    txt(2, 66, "Chỉ hỗ trợ 2D và 14", C_TEXT);
    waitAnyButton();
    return;
  }

  static uint8_t a[DUMP_LEN];
  if (!readStable(ct, rom, a)) { showResult(false, "ĐỌC LỖI", g_err); waitAnyButton(); return; }
  const uint16_t n = dumpLen(ct);

  uint8_t rev = 0xFF;
  bool revOk = (ct == CT_28E07) && readMemory(ct, rom, ADDR_REVISION, &rev, 1);

  // Lưu 16 byte vừa đọc làm MÃ CŨ (không lưu nếu đang là MÃ MỚI)
  bool saved = saveBackup(rom, a);

  // ---- Serial ----
  Serial.println("\n===== ĐỌC THIẾT BỊ =====");
  Serial.printf("Loại chip: %s\n", chipName(ct));
  Serial.print("ROM ID : "); printHexLine(rom, 8); Serial.println();
  Serial.printf("RAW (0x00..0x%02X): ", (unsigned)(n - 1)); printHexLine(a, n); Serial.println();

  // ---- TFT ----
  clearBody();
  drawRom(24, rom);
  drawHex16(2, 42, a, C_TEXT);

  char b[64];
  const uint16_t userEnd = (ct == CT_28E07) ? USER_LEN : n;   // hết vùng dữ liệu của từng loại chip
  bool rest00 = true, restFF = true;
  for (uint16_t i = WRITE_LEN; i < userEnd; i++) {
    if (a[i] != 0x00) rest00 = false;
    if (a[i] != 0xFF) restFF = false;
  }
  snprintf(b, sizeof(b), "0x10-0x%02X: %s", (unsigned)(userEnd - 1),
           rest00 ? "toàn 00" : (restFF ? "toàn FF" : "có dữ liệu"));
  txt(2, 78, b, C_DIM);

  if (ct == CT_28E07) {
    snprintf(b, sizeof(b), "P0:%02X %s  Rev:%02X", a[0x80], describeProtect(a[0x80]), revOk ? rev : 0xFF);
    txt(2, 94, b, a[0x80] == 0x00 ? C_OK : C_ERR);

    bool cp = (a[0x84] == 0x55 || a[0x84] == 0xAA);
    snprintf(b, sizeof(b), "Chống copy: %02X %s", a[0x84], cp ? "BẬT" : "tắt");
    txt(2, 110, b, C_TEXT);
  } else {
    txt(2, 94, "Không có khóa ghi", C_OK);
    txt(2, 110, "Bộ nhớ: 32 byte", C_TEXT);
  }

  snprintf(b, sizeof(b), "LOẠI CHIP: %s", chipName(ct));
  txt(2, 126, b, C_ACC);

  snprintf(b, sizeof(b), "NHẬN DIỆN: %s%s", nameOf(a), saved ? " [ĐÃ LƯU]" : "");
  txt(2, 140, b, strcmp(nameOf(a), "KHÁC") == 0 ? C_WARN : C_ACC);

  waitAnyButton();
}

// ================= XÁC NHẬN =================
// yesLbl: nhãn nút bên phải (GHI / LƯU / XÓA)
void drawChoice(bool yes, const char *yesLbl) {
  fillR(0, 128, SCR_W, 30, C_BG);
  // HỦY
  if (!yes) fillR(10, 130, 90, 24, C_ERR);
  else      strokeR(10, 130, 90, 24, C_ERR);
  txt(43, 134, "HỦY", yes ? C_TEXT : C_WHITE);
  // GHI / LƯU / XÓA
  if (yes)  fillR(120, 130, 90, 24, C_OK);
  else      strokeR(120, 130, 90, 24, C_OK);
  txt(153, 134, yesLbl, yes ? C_WHITE : C_TEXT);
}

bool confirmWrite(const char *yesLbl = "GHI") {
  bool yes = false;                      // mặc định là HỦY cho an toàn
  drawChoice(yes, yesLbl);
  while (true) {
    Event e = pollButtons();
    if (e == EV_NEXT) { yes = !yes; drawChoice(yes, yesLbl); }
    else if (e == EV_SELECT) return yes;
    delay(5);
  }
}

// ================= CHỨC NĂNG 2 + 3 + 4: GHI =================
// baseData   : dữ liệu nền để ghi (bị bỏ qua khi restore = true)
// randomLast : true = byte cuối của dữ liệu ghi là số ngẫu nhiên (GHI MÃ MỚI RANDOM)
// restore    : true = ghi lại MÃ CŨ đã lưu (chỉ khi ROM ID khớp chip đã backup)
void runWrite(const uint8_t *baseData, const char *title, const char *label,
              bool randomLast, bool restore) {
  drawScreen(title, "NAV: đổi   SEL: chọn");
  txt(6, 60, "Đang kiểm tra chip...", C_TEXT);

  uint8_t rom[8];
  ChipType ct;
  if (!findSupported(rom, ct)) return;

  if (restore) {
    if (!g_hasBk) {
      showResult(false, "CHƯA CÓ MÃ CŨ", "Hãy ĐỌC chip gốc trước");
      waitAnyButton(); return;
    }
    if (memcmp(rom, g_bkRom, 8) != 0) {
      showResult(false, "SAI CHIP", "Khác chip đã backup");
      waitAnyButton(); return;
    }
    baseData = g_bkData;
  }

  static uint8_t cur[DUMP_LEN];
  if (!readStable(ct, rom, cur)) { showResult(false, "ĐỌC LỖI", g_err); waitAnyButton(); return; }

  if (ct == CT_28E07 && (cur[0x80] == 0x55 || cur[0x80] == 0xAA)) {
    showResult(false, "PAGE 0 BỊ KHÓA", describeProtect(cur[0x80]));
    waitAnyButton(); return;
  }

  // Tạo dữ liệu sẽ ghi; nếu randomLast thì byte cuối là ngẫu nhiên
  uint8_t newData[WRITE_LEN];
  memcpy(newData, baseData, WRITE_LEN);
  if (randomLast) {
    do {
      newData[WRITE_LEN - 1] = (uint8_t)(esp_random() & 0xFF);
    } while (memcmp(newData, cur, WRITE_LEN) == 0);   // tránh trùng đúng dữ liệu hiện tại
  }

  if (memcmp(cur, newData, WRITE_LEN) == 0) {
    showResult(true, "ĐÃ GIỐNG", "Không cần ghi lại");
    waitAnyButton(); return;
  }

  // Backup ra Serial
  Serial.printf("\n===== %s =====\n", title);
  Serial.printf("Loại chip        : %s\n", chipName(ct));
  Serial.print("Chip ROM         : "); printHexLine(rom, 8); Serial.println();
  Serial.print("BACKUP (hiện tại): "); printHexLine(cur, WRITE_LEN); Serial.println();
  Serial.print("SẼ GHI           : "); printHexLine(newData, WRITE_LEN); Serial.println();

  // Màn hình xác nhận
  clearBody();
  char b[64];
  snprintf(b, sizeof(b), "Hiện tại (%s):", nameOf(cur));
  txt(2, 24, b, C_DIM);
  drawHex16(2, 40, cur, C_TEXT);
  snprintf(b, sizeof(b), "Sẽ ghi (%s):", label);
  txt(2, 76, b, C_WARN);
  drawHex16(2, 92, newData, C_WARN);

  if (!confirmWrite("GHI")) {
    showResult(false, "ĐÃ HỦY", "Không ghi gì cả");
    waitAnyButton(); return;
  }

  // Ghi mã mới: lưu mã hiện tại (vừa đọc từ chip) làm MÃ CŨ trước khi ghi đè.
  // (Không lưu đè nếu chip đang là MÃ MỚI; khôi phục thì giữ nguyên backup.)
  if (!restore) saveBackup(rom, cur);

  // Ghi
  clearBody();
  txtS(6, 50, "ĐANG GHI...", C_WARN, 2);
  txt(6, 90, "Giữ chip chắc, đừng rút!", C_TEXT);

  if (!writeUser16(ct, rom, cur, newData)) {
    Serial.println("GHI LỖI. Backup nằm ở dòng trên.");
    showResult(false, "GHI LỖI", g_err);
    waitAnyButton(); return;
  }

  // Kiểm tra: 16 byte vừa ghi khớp, phần còn lại (0x10.. và admin) không đổi
  static uint8_t after[DUMP_LEN];
  if (!readStable(ct, rom, after)) { showResult(false, "ĐỌC LẠI LỖI", g_err); waitAnyButton(); return; }
  const uint16_t n = dumpLen(ct);
  bool dataOk = (memcmp(after, newData, WRITE_LEN) == 0);
  bool restOk = (memcmp(after + WRITE_LEN, cur + WRITE_LEN, n - WRITE_LEN) == 0);

  Serial.print("RAW sau khi ghi: "); printHexLine(after, n); Serial.println();
  Serial.printf("16 byte: %s | Vùng còn lại + admin: %s\n",
                dataOk ? "KHỚP" : "KHÔNG KHỚP", restOk ? "không đổi" : "BỊ ĐỔI!");

  if (dataOk && restOk) {
    showResult(true, "THÀNH CÔNG", label);
    drawHex16(8, 96, after, C_OK);
  } else {
    showResult(false, "CHƯA ĐÚNG", dataOk ? "Vùng khác bị đổi" : "Dữ liệu không khớp");
  }
  waitAnyButton();
}

// ================= DANH SÁCH THIẾT BỊ: chọn / thêm / xóa =================
constexpr int LIST_VIS = 5;
constexpr int LIST_Y0  = 26;
constexpr int LIST_RH  = 22;

// mgr = true : [0]="+ Thêm", [1..n]=thiết bị, [n+1]="Quay lại"
// mgr = false: [0..n-1]=thiết bị, [n]="Quay lại"
int listTotal(bool mgr) { return g_nDev + (mgr ? 1 : 0) + 1; }

void listLabel(int i, bool mgr, char *b, size_t sz) {
  if (mgr && i == 0) { snprintf(b, sz, "+ Thêm thiết bị mới"); return; }
  int d = i - (mgr ? 1 : 0);
  if (d >= g_nDev)   { snprintf(b, sz, "Quay lại"); return; }
  const uint8_t *p = g_dev[d];
  snprintf(b, sz, "%d: %02X%02X%02X%02X%02X%02X%02X%02X",
           d + 1, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
}

void drawListRows(int sel, int top, bool mgr) {
  int total = listTotal(mgr);
  char b[40];
  for (int s = 0; s < LIST_VIS; s++) {
    int i = top + s;
    int y = LIST_Y0 + s * LIST_RH;
    if (i >= total) { fillR(4, y, SCR_W - 8, 20, C_BG); continue; }
    listLabel(i, mgr, b, sizeof(b));
    if (i == sel) {
      fillR(4, y, SCR_W - 8, 20, C_SEL);
    } else {
      fillR(4, y, SCR_W - 8, 20, C_BG);
      strokeR(4, y, SCR_W - 8, 20, C_DIM);
    }
    txt(12, y + 2, b, C_TEXT);
  }
}

// Trả về chỉ số mục được chọn (theo quy ước ở trên)
int menuList(const char *title, bool mgr) {
  drawScreen(title, "NAV: xuống   SEL: chọn");
  int total = listTotal(mgr), sel = 0, top = 0;
  drawListRows(sel, top, mgr);
  while (true) {
    Event e = pollButtons();
    if (e == EV_NEXT) {
      sel = (sel + 1) % total;
      if (sel < top) top = sel;
      else if (sel >= top + LIST_VIS) top = sel - LIST_VIS + 1;
      drawListRows(sel, top, mgr);
    } else if (e == EV_SELECT) {
      return sel;
    }
    delay(5);
  }
}

// Chọn thiết bị mã mới để ghi. Trả về chỉ số thiết bị, hoặc -1 nếu quay lại / chưa có
int pickDevice(const char *title) {
  if (g_nDev == 0) {
    drawScreen(title, "SEL: quay lại");
    showResult(false, "Chưa có mã mới", "Hãy thêm ở mục 5");
    waitAnyButton();
    return -1;
  }
  int s = menuList(title, false);
  return (s < g_nDev) ? s : -1;
}

// Thêm thiết bị mới: đọc 16 byte từ chip đang cắm (DS28E07 hoặc DS2430A)
void doAddDevice() {
  drawScreen("ĐỌC MÃ MỚI", "SEL: quay lại menu");
  txt(6, 60, "Đang đọc chip...", C_TEXT);

  if (g_nDev >= MAX_DEV) {
    showResult(false, "Danh sách đầy", "Hãy xóa bớt thiết bị");
    waitAnyButton(); return;
  }

  uint8_t rom[8];
  ChipType ct;
  if (!findSupported(rom, ct)) return;

  static uint8_t cur[DUMP_LEN];
  if (!readStable(ct, rom, cur)) { showResult(false, "ĐỌC LỖI", g_err); waitAnyButton(); return; }

  int dup = findNewIdx(cur);
  if (dup >= 0) {
    char b[32];
    snprintf(b, sizeof(b), "Trùng thiết bị số %d", dup + 1);
    showResult(false, "Đã có rồi", b);
    waitAnyButton(); return;
  }

  clearBody();
  char b[48];
  txt(2, 24, "Dữ liệu chip hiện tại:", C_DIM);
  drawHex16(2, 40, cur, C_TEXT);
  snprintf(b, sizeof(b), "Lưu làm TB số %d?", g_nDev + 1);
  txt(2, 82, b, C_WARN);
  txt(2, 100, "Byte cuối sẽ random khi ghi", C_DIM);

  if (!confirmWrite("LƯU")) {
    showResult(false, "ĐÃ HỦY", "Không lưu gì cả");
    waitAnyButton(); return;
  }

  memcpy(g_dev[g_nDev], cur, WRITE_LEN);
  g_nDev++;
  saveDevices();

  // Nếu 16 byte này lỡ bị lưu làm MÃ CŨ trước đó thì hủy backup đó
  if (g_hasBk && memcmp(g_bkData, cur, WRITE_LEN - 1) == 0) {
    g_hasBk = false;
    prefs.remove("bkdat");
    prefs.remove("bkrom");
  }

  Serial.printf("Đã thêm thiết bị mới số %d (%s): ", g_nDev, chipName(ct));
  printHexLine(cur, WRITE_LEN); Serial.println();
  snprintf(b, sizeof(b), "Thiết bị số %d", g_nDev);
  showResult(true, "ĐÃ LƯU", b);
  waitAnyButton();
}

void doDeleteDevice(int d) {
  drawScreen("XÓA MÃ MỚI", "NAV: đổi   SEL: chọn");
  char b[40];
  snprintf(b, sizeof(b), "Xóa thiết bị số %d?", d + 1);
  txt(2, 24, b, C_WARN);
  drawHex16(2, 44, g_dev[d], C_TEXT);

  if (!confirmWrite("XÓA")) return;

  for (int i = d; i < g_nDev - 1; i++) memcpy(g_dev[i], g_dev[i + 1], WRITE_LEN);
  g_nDev--;
  saveDevices();
  showResult(true, "ĐÃ XÓA", "Đã cập nhật danh sách");
  waitAnyButton();
}

// Màn hình quản lý danh sách (menu mục 5)
void runDevices() {
  while (true) {
    int s = menuList("THIẾT BỊ MỚI", true);
    if (s == 0)                 doAddDevice();
    else if (s >= 1 + g_nDev)   return;              // Quay lại
    else                        doDeleteDevice(s - 1);
  }
}

// ================= CHỨC NĂNG 6: CÀI ĐẶT MÀN HÌNH =================
constexpr int SET_N = 5;

void drawSettingRow(int i, int sel) {
  char b[48];
  switch (i) {
    case 0: snprintf(b, sizeof(b), "HƯỚNG: %d", g_orient); break;
    case 1: snprintf(b, sizeof(b), "LẬT DỌC: %s", g_flipY ? "BẬT" : "TẮT"); break;
    case 2: snprintf(b, sizeof(b), "LẬT NGANG: %s", g_flipX ? "BẬT" : "TẮT"); break;
    case 3: snprintf(b, sizeof(b), "ĐẢO MÀU: %s", g_inv ? "BẬT" : "TẮT"); break;
    default: snprintf(b, sizeof(b), "LƯU VÀ THOÁT"); break;
  }
  int y = 26 + i * 26;
  if (i == sel) {
    fillR(4, y, SCR_W - 8, 22, C_SEL);
  } else {
    fillR(4, y, SCR_W - 8, 22, C_BG);
    strokeR(4, y, SCR_W - 8, 22, C_DIM);
  }
  txt(12, y + 3, b, C_TEXT);
}

void drawSettings(int sel) {
  drawScreen("CÀI ĐẶT MÀN HÌNH", "NAV: xuống   SEL: đổi");
  for (int i = 0; i < SET_N; i++) drawSettingRow(i, sel);
}

void runSettings() {
  int sel = 0;
  applyDisplay();
  drawSettings(sel);
  while (true) {
    Event e = pollButtons();
    if (e == EV_NEXT) {
      int old = sel;
      sel = (sel + 1) % SET_N;
      drawSettingRow(old, sel);
      drawSettingRow(sel, sel);
    } else if (e == EV_SELECT) {
      switch (sel) {
        case 0: g_orient = (g_orient == 1) ? 3 : 1; applyDisplay(); break;
        case 1: g_flipY = !g_flipY; break;
        case 2: g_flipX = !g_flipX; break;
        case 3: g_inv = !g_inv; applyDisplay(); break;
        default: saveSettings(); return;
      }
      drawSettings(sel);
    }
    delay(5);
  }
}

